[
  {
    "name": "change_world",
    "description": "Apply one settled world change to match the story. Set `verb` to pick the change and fill that verb's own fields. One call makes one change.",
    "parameters": {
      "$defs": {
        "AddTrait": {
          "additionalProperties": false,
          "description": "Add a lasting condition or quality to an entity.",
          "properties": {
            "verb": {
              "const": "add_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id. An actor must be here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "name": {
              "description": "Display name, such as `Battle Worn`.",
              "minLength": 1,
              "type": "string"
            },
            "text": {
              "description": "The effect in plain language.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "name",
            "text"
          ],
          "title": "AddTrait",
          "type": "object"
        },
        "AdvanceThread": {
          "additionalProperties": false,
          "description": "Update an active storyline's status or the line the player reads about it.",
          "properties": {
            "verb": {
              "const": "advance_thread",
              "type": "string"
            },
            "thread_id": {
              "description": "Exact id of an active thread.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "active",
                    "resolved",
                    "dormant"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "New status, or null to keep the current status."
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What the player now knows about this thread, or the lead they have on it, in one sentence. The player reads this. Null keeps the current note."
            }
          },
          "required": [
            "verb",
            "thread_id"
          ],
          "title": "AdvanceThread",
          "type": "object"
        },
        "ImproviseItem": {
          "additionalProperties": false,
          "description": "Give the player an ordinary object not already in the world.",
          "properties": {
            "verb": {
              "const": "improvise_item",
              "type": "string"
            },
            "name": {
              "description": "The object's name, such as `a handful of gravel`.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "verb",
            "name"
          ],
          "title": "ImproviseItem",
          "type": "object"
        },
        "JoinParty": {
          "additionalProperties": false,
          "description": "An actor here starts travelling with the player.",
          "properties": {
            "verb": {
              "const": "join_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor joining.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "JoinParty",
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Record that an actor has died. What they carried falls loose here.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor here who died.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "Kill",
          "type": "object"
        },
        "LeaveParty": {
          "additionalProperties": false,
          "description": "A companion stops travelling with the player.",
          "properties": {
            "verb": {
              "const": "leave_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the companion leaving.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "LeaveParty",
          "type": "object"
        },
        "MoveItem": {
          "additionalProperties": false,
          "description": "Move an item: to the player, to someone here, or loose in this place.",
          "properties": {
            "verb": {
              "const": "move_item",
              "type": "string"
            },
            "item_id": {
              "description": "Exact id of an item here or carried.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "to": {
              "description": "`player`, `place`, or the exact id of an actor here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "item_id",
            "to"
          ],
          "title": "MoveItem",
          "type": "object"
        },
        "RemoveTrait": {
          "additionalProperties": false,
          "description": "Remove a lasting condition that has ended.",
          "properties": {
            "verb": {
              "const": "remove_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "trait_id": {
              "description": "Exact id of one of its traits.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "trait_id"
          ],
          "title": "RemoveTrait",
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "Make a hidden entity known when the player notices, finds, or reaches it.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of an entity listed as hidden here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Reveal",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The one world change to apply; `verb` picks the change.",
          "discriminator": {
            "mapping": {
              "add_trait": "#/$defs/AddTrait",
              "advance_thread": "#/$defs/AdvanceThread",
              "improvise_item": "#/$defs/ImproviseItem",
              "join_party": "#/$defs/JoinParty",
              "kill": "#/$defs/Kill",
              "leave_party": "#/$defs/LeaveParty",
              "move_item": "#/$defs/MoveItem",
              "remove_trait": "#/$defs/RemoveTrait",
              "reveal": "#/$defs/Reveal"
            },
            "propertyName": "verb"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/MoveItem"
            },
            {
              "$ref": "#/$defs/ImproviseItem"
            },
            {
              "$ref": "#/$defs/AddTrait"
            },
            {
              "$ref": "#/$defs/RemoveTrait"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/JoinParty"
            },
            {
              "$ref": "#/$defs/LeaveParty"
            },
            {
              "$ref": "#/$defs/AdvanceThread"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "move",
    "description": "Move through an unlocked way from the player's current place.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "to_id": {
          "description": "Exact id of the place to move to.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "to_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "unlock_way",
    "description": "Unlock a locked way out of the player's current place.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "to_id": {
          "description": "Exact id of the locked way's destination.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "to_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "danger_roll",
    "description": "Roll 2d6 plus an ability against 10, or against a resisting actor, to see whether an actor avoids a danger. NPC morale is a will danger roll.",
    "parameters": {
      "$defs": {
        "Ability": {
          "enum": [
            "strength",
            "dexterity",
            "will"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the actor taking the danger roll.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "ability": {
          "$ref": "#/$defs/Ability",
          "description": "Ability bonus used: strength, dexterity, or will."
        },
        "danger": {
          "description": "The danger this roll determines whether they avoid.",
          "minLength": 1,
          "type": "string"
        },
        "advantage": {
          "default": false,
          "description": "Roll 3d6 and keep the best two dice.",
          "type": "boolean"
        },
        "opposed_by": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of the actor resisting this action, who rolls against the actor and wins ties; null for an ordinary roll against 10."
        },
        "opposed_ability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ability"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ability the resisting actor uses; null means the same one the actor used."
        }
      },
      "required": [
        "actor_id",
        "ability",
        "danger"
      ],
      "type": "object"
    }
  },
  {
    "name": "reaction",
    "description": "Roll 1d6 for the disposition of an encountered actor whose stance is unknown.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the encountered actor whose disposition is unknown.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "attack",
    "description": "Resolve one Maze Rats attack, opening combat on its first swing.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the actor making this attack.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "target_id": {
          "description": "Exact id of the opposing actor being attacked.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "weapon_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact weapon item held by the attacker, or null for unarmed."
        },
        "ambush": {
          "default": false,
          "description": "The attacker's side ambushes: it seizes initiative and strikes at advantage.",
          "type": "boolean"
        },
        "shatter_shield": {
          "default": false,
          "description": "Only for the listed shield decision: destroy the target's shield to ignore this hit.",
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "target_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "stow",
    "description": "Move one carried item between hands, worn, belt, and backpack; a weapon must be drawn into the hands before it can be attacked with.",
    "parameters": {
      "$defs": {
        "CarryPosition": {
          "enum": [
            "worn",
            "belt",
            "backpack",
            "hands"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the actor rearranging their gear.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "item_id": {
          "description": "Exact id of an item that actor already carries.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/CarryPosition",
          "description": "Where the item goes: hands, worn, belt, or backpack."
        }
      },
      "required": [
        "actor_id",
        "item_id",
        "position"
      ],
      "type": "object"
    }
  },
  {
    "name": "cast_spell",
    "description": "Consume a generated spell and record the game master's fixed ruling.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the actor casting the spell.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "slot": {
          "description": "Zero-based spell-slot index to consume.",
          "minimum": 0,
          "type": "integer"
        },
        "effect": {
          "description": "The fixed general effect ruling for this spell.",
          "minLength": 1,
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact target actor or null when the spell targets the scene."
        }
      },
      "required": [
        "actor_id",
        "slot",
        "effect"
      ],
      "type": "object"
    }
  },
  {
    "name": "rest",
    "description": "Rest for a night or a safe day, take medicine, and refill empty spell slots.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the actor taking the rest.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "default": "night",
          "description": "A meal and a full night for 1 health, or a safe day for all of it.",
          "enum": [
            "night",
            "day"
          ],
          "type": "string"
        },
        "medicine_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional medicine item carried by the actor to consume."
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "level_up",
    "description": "Award one to three session XP and resolve the resulting level choice.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the party member receiving XP or leveling.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "amount": {
          "default": 0,
          "description": "XP earned at session end, from zero to three.",
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "choice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The exact pending level-up option, or null to award XP and open it."
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  }
]
