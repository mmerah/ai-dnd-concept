[
  {
    "name": "change_world",
    "description": "Apply one settled world change to match the story. Set `verb` to pick the change and fill that verb's own fields. One call makes one change.",
    "parameters": {
      "$defs": {
        "AddTrait": {
          "additionalProperties": false,
          "description": "Add a lasting condition or quality to an entity.",
          "properties": {
            "verb": {
              "const": "add_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id. An actor must be here with the player.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "name": {
              "description": "The trait's display name, such as `Battle Worn`; its id is derived.",
              "minLength": 1,
              "type": "string"
            },
            "text": {
              "description": "The trait's effect in plain language.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "name",
            "text"
          ],
          "title": "AddTrait",
          "type": "object"
        },
        "AdvanceThreadArm": {
          "additionalProperties": false,
          "description": "Update an active storyline's status or note.",
          "properties": {
            "thread_id": {
              "description": "Exact id of an ACTIVE THREAD.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "active",
                    "resolved",
                    "dormant"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "New status, or null to keep the current status."
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "New private note for the Director, or null to keep the current note."
            },
            "verb": {
              "const": "advance_thread",
              "type": "string"
            }
          },
          "required": [
            "thread_id",
            "verb"
          ],
          "title": "AdvanceThreadArm",
          "type": "object"
        },
        "GainImprovisedItem": {
          "additionalProperties": false,
          "description": "Give the player an ordinary, unimportant object not already in the world.",
          "properties": {
            "verb": {
              "const": "gain_improvised_item",
              "type": "string"
            },
            "item_name": {
              "description": "The object's name, such as `a handful of gravel`.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "item_name"
          ],
          "title": "GainImprovisedItem",
          "type": "object"
        },
        "JoinParty": {
          "additionalProperties": false,
          "description": "Add an actor here to the player's party.",
          "properties": {
            "verb": {
              "const": "join_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor joining.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "JoinParty",
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Record that an actor has died. Their body and what they carried stay in the world.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor who has died. They must be here with the player.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "Kill",
          "type": "object"
        },
        "LeaveParty": {
          "additionalProperties": false,
          "description": "Remove an actor from the player's party.",
          "properties": {
            "verb": {
              "const": "leave_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor leaving.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "LeaveParty",
          "type": "object"
        },
        "Move": {
          "additionalProperties": false,
          "description": "Move an actor to a new location, or move a nearby item.",
          "properties": {
            "verb": {
              "const": "move",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact actor or item id. The item must be carried by the player or loose here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "to_id": {
              "description": "Exact destination id. An actor moves to a location id. An item is taken by moving it to `player`, handed over by moving it to an actor here, and dropped by moving it to the id of the player's current location.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "to_id"
          ],
          "title": "Move",
          "type": "object"
        },
        "RemoveTrait": {
          "additionalProperties": false,
          "description": "Remove a lasting condition or quality that has ended.",
          "properties": {
            "verb": {
              "const": "remove_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id. An actor must be here with the player.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "trait_id": {
              "description": "Exact id of one of the entity's traits.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "trait_id"
          ],
          "title": "RemoveTrait",
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "Make a hidden entity known when the player notices, finds, or reaches it.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the hidden entity.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Reveal",
          "type": "object"
        },
        "UnlockExit": {
          "additionalProperties": false,
          "description": "Unlock an exit from the player's location.",
          "properties": {
            "verb": {
              "const": "unlock_exit",
              "type": "string"
            },
            "to_id": {
              "description": "Exact id of the exit's destination.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "to_id"
          ],
          "title": "UnlockExit",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The one world change to apply; `verb` picks the change.",
          "discriminator": {
            "mapping": {
              "add_trait": "#/$defs/AddTrait",
              "advance_thread": "#/$defs/AdvanceThreadArm",
              "gain_improvised_item": "#/$defs/GainImprovisedItem",
              "join_party": "#/$defs/JoinParty",
              "kill": "#/$defs/Kill",
              "leave_party": "#/$defs/LeaveParty",
              "move": "#/$defs/Move",
              "remove_trait": "#/$defs/RemoveTrait",
              "reveal": "#/$defs/Reveal",
              "unlock_exit": "#/$defs/UnlockExit"
            },
            "propertyName": "verb"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GainImprovisedItem"
            },
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/Move"
            },
            {
              "$ref": "#/$defs/AddTrait"
            },
            {
              "$ref": "#/$defs/RemoveTrait"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/UnlockExit"
            },
            {
              "$ref": "#/$defs/JoinParty"
            },
            {
              "$ref": "#/$defs/LeaveParty"
            },
            {
              "$ref": "#/$defs/AdvanceThreadArm"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "roll_question",
    "description": "Roll Chance against Risk for one closed dramatic question.",
    "parameters": {
      "$defs": {
        "Position": {
          "enum": [
            "advantage",
            "neutral",
            "disadvantage"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or actor here who takes the action.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "question": {
          "description": "Closed question where yes means the actor gets what they want.",
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position",
          "default": "neutral",
          "description": "Which side the relevant tags and situation favour."
        },
        "edge": {
          "default": "",
          "description": "Tag or circumstance that sets the position. Empty for neutral.",
          "type": "string"
        },
        "opponent_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of the actor or item here that resists. Null when nothing fights back."
        }
      },
      "required": [
        "actor_id",
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "restore_luck",
    "description": "Restore an actor's luck after a conflict ends.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or an actor here.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "complete_chapter",
    "description": "Record that the current adventure has ended.",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "advance",
    "description": "Spend one advance a party member has earned, when the player asks for it. Choose the changes this adventure earned: a new skill, signature gear, a frailty, or a rewrite of an existing tag.",
    "parameters": {
      "$defs": {
        "Change": {
          "additionalProperties": false,
          "description": "One sheet change earned by the adventure.",
          "properties": {
            "kind": {
              "description": "Type of sheet change.",
              "enum": [
                "skill",
                "gear",
                "frailty",
                "rewrite"
              ],
              "type": "string"
            },
            "tag": {
              "description": "New title-case tag, or the exact current tag for a rewrite.",
              "minLength": 1,
              "type": "string"
            },
            "into": {
              "default": "",
              "description": "New title-case tag for a rewrite. Empty for other kinds.",
              "type": "string"
            },
            "why": {
              "description": "One short reason, in the fiction, for this change.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tag",
            "why"
          ],
          "title": "Change",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "All sheet changes earned by one adventure.",
      "properties": {
        "subject_id": {
          "description": "Exact id of the party member who advances.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "changes": {
          "description": "Every earned change, in reading order.",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "changes"
      ],
      "type": "object"
    }
  }
]
