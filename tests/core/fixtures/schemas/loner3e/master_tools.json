[
  {
    "name": "change_world",
    "description": "Call this when the story has settled a change to the world. Fill the fields of the verb you pick. One call makes one change.",
    "parameters": {
      "$defs": {
        "ChangeTags": {
          "additionalProperties": false,
          "description": "A character here gains tags, loses tags, or both.",
          "properties": {
            "verb": {
              "const": "change_tags",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the player or someone here.",
              "type": "string"
            },
            "kind": {
              "description": "`gear` for a thing taken or lost. `condition` for a lasting mark such as `Poisoned`.",
              "enum": [
                "skill",
                "frailty",
                "gear",
                "condition"
              ],
              "type": "string"
            },
            "gained": {
              "default": [],
              "description": "Title-case tags gained, such as `Rusty Key`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "lost": {
              "default": [],
              "description": "Exact tags lost, lifted or used up.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "kind"
          ],
          "type": "object"
        },
        "Drive": {
          "additionalProperties": false,
          "description": "A living character's goal, motive or nemesis is written.",
          "properties": {
            "verb": {
              "const": "drive",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the player or a living character here.",
              "type": "string"
            },
            "goal": {
              "default": "",
              "description": "What they now pursue, in one line. Empty keeps the current goal.",
              "type": "string"
            },
            "motive": {
              "default": "",
              "description": "Why, in one line. Empty keeps the current motive.",
              "type": "string"
            },
            "nemesis": {
              "default": "",
              "description": "Who or what stands in their way. Empty keeps the current nemesis.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "Enter": {
          "additionalProperties": false,
          "description": "A cast member comes into the scene.",
          "properties": {
            "verb": {
              "const": "enter",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of a cast member not already here.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "JoinParty": {
          "additionalProperties": false,
          "description": "A character here starts travelling with the player.",
          "properties": {
            "verb": {
              "const": "join_party",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of who is joining.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Someone here dies.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of who here died.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "Leave": {
          "additionalProperties": false,
          "description": "A cast member goes out of the scene.",
          "properties": {
            "verb": {
              "const": "leave",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of someone here.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "LeaveParty": {
          "additionalProperties": false,
          "description": "A party member stops travelling with the player.",
          "properties": {
            "verb": {
              "const": "leave_party",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the party member leaving.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "RestoreLuck": {
          "additionalProperties": false,
          "description": "A character's luck is restored in full.",
          "properties": {
            "verb": {
              "const": "restore_luck",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the player or a character here.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "A hidden entity here becomes known to the player.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of an entity listed as hidden here.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The change to apply. `verb` picks which one.",
          "oneOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/Enter"
            },
            {
              "$ref": "#/$defs/Leave"
            },
            {
              "$ref": "#/$defs/ChangeTags"
            },
            {
              "$ref": "#/$defs/Drive"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/JoinParty"
            },
            {
              "$ref": "#/$defs/LeaveParty"
            },
            {
              "$ref": "#/$defs/RestoreLuck"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "next_scene",
    "description": "Call this with nothing set when the scene reaches a stopping point. Set `pursuit` instead once the player has left this place. Set `complication` instead to bring a new situation down on this place.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "pursuit": {
          "default": "",
          "description": "Where the player is going, in their own words. Empty to offer the way on.",
          "type": "string"
        },
        "complication": {
          "default": "",
          "description": "What arrives or turns here, and why. Empty otherwise.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "roll",
    "description": "Call this for one closed dramatic question. The engine rolls Chance against Risk, reads the answer, and moves luck in a conflict.",
    "parameters": {
      "$defs": {
        "Position": {
          "enum": [
            "advantage",
            "neutral",
            "disadvantage"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "what": {
          "description": "The attempt, in a few words the player reads.",
          "type": "string"
        },
        "actor_id": {
          "description": "Exact id of the character here who acts.",
          "type": "string"
        },
        "question": {
          "description": "Closed question where yes means the actor gets what they want. Only you read it.",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position",
          "default": "neutral",
          "description": "Which side the relevant tags and situation favour."
        },
        "edge": {
          "default": "",
          "description": "Tag or circumstance that sets the position, read by the player. Empty for neutral.",
          "type": "string"
        },
        "opponent_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of the character here that resists. Null when nothing fights back."
        }
      },
      "required": [
        "what",
        "actor_id",
        "question"
      ],
      "type": "object"
    }
  }
]
