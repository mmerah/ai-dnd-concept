[
  {
    "name": "change_world",
    "description": "Apply one settled world change to match the story. Set `verb` to pick the change and fill that verb's own fields. One call makes one change.",
    "parameters": {
      "$defs": {
        "AddTrait": {
          "additionalProperties": false,
          "description": "Add a lasting condition or quality to an entity.",
          "properties": {
            "verb": {
              "const": "add_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id. An actor must be here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "name": {
              "description": "Display name, such as `Battle Worn`.",
              "minLength": 1,
              "type": "string"
            },
            "text": {
              "description": "The effect in plain language.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "name",
            "text"
          ],
          "title": "AddTrait",
          "type": "object"
        },
        "AdvanceThread": {
          "additionalProperties": false,
          "description": "Update an active storyline's status or the line the player reads about it.",
          "properties": {
            "verb": {
              "const": "advance_thread",
              "type": "string"
            },
            "thread_id": {
              "description": "Exact id of an active thread.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "active",
                    "resolved",
                    "dormant"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "New status, or null to keep the current status."
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "What the player now knows about this thread, or the lead they have on it, in one sentence. The player reads this. Null keeps the current note."
            }
          },
          "required": [
            "verb",
            "thread_id"
          ],
          "title": "AdvanceThread",
          "type": "object"
        },
        "Enter": {
          "additionalProperties": false,
          "description": "Bring a cast member into the current scene.",
          "properties": {
            "verb": {
              "const": "enter",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of a cast member not already here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Enter",
          "type": "object"
        },
        "ImproviseItem": {
          "additionalProperties": false,
          "description": "Give the player an ordinary object not already in the world.",
          "properties": {
            "verb": {
              "const": "improvise_item",
              "type": "string"
            },
            "name": {
              "description": "The object's name, such as `a handful of gravel`.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "verb",
            "name"
          ],
          "title": "ImproviseItem",
          "type": "object"
        },
        "JoinParty": {
          "additionalProperties": false,
          "description": "An actor here starts travelling with the player.",
          "properties": {
            "verb": {
              "const": "join_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor joining.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "JoinParty",
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Record that an actor has died. What they carried falls loose here.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor here who died.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "Kill",
          "type": "object"
        },
        "Leave": {
          "additionalProperties": false,
          "description": "Take a cast member out of the current scene.",
          "properties": {
            "verb": {
              "const": "leave",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of someone here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Leave",
          "type": "object"
        },
        "LeaveParty": {
          "additionalProperties": false,
          "description": "A companion stops travelling with the player.",
          "properties": {
            "verb": {
              "const": "leave_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the companion leaving.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "LeaveParty",
          "type": "object"
        },
        "MoveItem": {
          "additionalProperties": false,
          "description": "Move an item: to the player, to someone here, or loose in the scene.",
          "properties": {
            "verb": {
              "const": "move_item",
              "type": "string"
            },
            "item_id": {
              "description": "Exact id of an item here or carried.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "to": {
              "description": "`player`, `scene`, or the exact id of an actor here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "item_id",
            "to"
          ],
          "title": "MoveItem",
          "type": "object"
        },
        "RemoveTrait": {
          "additionalProperties": false,
          "description": "Remove a lasting condition that has ended.",
          "properties": {
            "verb": {
              "const": "remove_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "trait_id": {
              "description": "Exact id of one of its traits.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "trait_id"
          ],
          "title": "RemoveTrait",
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "Make a hidden entity known when the player notices, finds, or reaches it.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of an entity listed as hidden here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Reveal",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The one world change to apply; `verb` picks the change.",
          "discriminator": {
            "mapping": {
              "add_trait": "#/$defs/AddTrait",
              "advance_thread": "#/$defs/AdvanceThread",
              "enter": "#/$defs/Enter",
              "improvise_item": "#/$defs/ImproviseItem",
              "join_party": "#/$defs/JoinParty",
              "kill": "#/$defs/Kill",
              "leave": "#/$defs/Leave",
              "leave_party": "#/$defs/LeaveParty",
              "move_item": "#/$defs/MoveItem",
              "remove_trait": "#/$defs/RemoveTrait",
              "reveal": "#/$defs/Reveal"
            },
            "propertyName": "verb"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/Enter"
            },
            {
              "$ref": "#/$defs/Leave"
            },
            {
              "$ref": "#/$defs/MoveItem"
            },
            {
              "$ref": "#/$defs/ImproviseItem"
            },
            {
              "$ref": "#/$defs/AddTrait"
            },
            {
              "$ref": "#/$defs/RemoveTrait"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/JoinParty"
            },
            {
              "$ref": "#/$defs/LeaveParty"
            },
            {
              "$ref": "#/$defs/AdvanceThread"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "roll_question",
    "description": "Roll Chance against Risk for one closed dramatic question.",
    "parameters": {
      "$defs": {
        "Position": {
          "enum": [
            "advantage",
            "neutral",
            "disadvantage"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or actor here who takes the action.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "question": {
          "description": "Closed question where yes means the actor gets what they want.",
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position",
          "default": "neutral",
          "description": "Which side the relevant tags and situation favour."
        },
        "edge": {
          "default": "",
          "description": "Tag or circumstance that sets the position. Empty for neutral.",
          "type": "string"
        },
        "opponent_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of the actor or item here that resists. Null when nothing fights back."
        }
      },
      "required": [
        "actor_id",
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "restore_luck",
    "description": "Restore an actor's luck after a conflict ends.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or an actor here.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "complete_chapter",
    "description": "Record that the current adventure has ended.",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "advance",
    "description": "Spend one advance a party member has earned, when the player asks for it. Choose the changes this adventure earned: a new skill, signature gear, a frailty, or a rewrite of an existing tag.",
    "parameters": {
      "$defs": {
        "Change": {
          "additionalProperties": false,
          "description": "One sheet change earned by the adventure.",
          "properties": {
            "kind": {
              "description": "Type of sheet change.",
              "enum": [
                "skill",
                "gear",
                "frailty",
                "rewrite"
              ],
              "type": "string"
            },
            "tag": {
              "description": "New title-case tag, or the exact current tag for a rewrite.",
              "minLength": 1,
              "type": "string"
            },
            "into": {
              "default": "",
              "description": "New title-case tag for a rewrite. Empty for other kinds.",
              "type": "string"
            },
            "why": {
              "description": "One short reason, in the fiction, for this change.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tag",
            "why"
          ],
          "title": "Change",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "All sheet changes earned by one adventure.",
      "properties": {
        "subject_id": {
          "description": "Exact id of the party member who advances.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "changes": {
          "description": "Every earned change, in reading order.",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "changes"
      ],
      "type": "object"
    }
  }
]
