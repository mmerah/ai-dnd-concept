[
  {
    "name": "change_world",
    "description": "Apply one settled world change to match the story. Set `verb` to pick the change and fill that verb's own fields. One call makes one change.",
    "parameters": {
      "$defs": {
        "ChangeTags": {
          "additionalProperties": false,
          "description": "A character here gains or loses tags: a thing taken or lost, a lasting mark, a lesson.",
          "properties": {
            "verb": {
              "const": "change_tags",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the player or someone here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "kind": {
              "description": "`gear` for a thing taken or lost; `condition` for a lasting mark such as `Battle Worn` or `Poisoned`; `skill` or `frailty` only when the story plainly wrote one.",
              "enum": [
                "skill",
                "frailty",
                "gear",
                "condition"
              ],
              "type": "string"
            },
            "gained": {
              "default": [],
              "description": "Title-case tags gained, such as `Rusty Key`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "lost": {
              "default": [],
              "description": "Exact tags lost, lifted or used up.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "kind"
          ],
          "title": "ChangeTags",
          "type": "object"
        },
        "Drive": {
          "additionalProperties": false,
          "description": "What a living character wants, why, and who stands in their way, once play has shown it.",
          "properties": {
            "verb": {
              "const": "drive",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the player or a living character here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "goal": {
              "default": "",
              "description": "What they now pursue, in one line. Empty keeps the current goal.",
              "type": "string"
            },
            "motive": {
              "default": "",
              "description": "Why, in one line. Empty keeps the current motive.",
              "type": "string"
            },
            "nemesis": {
              "default": "",
              "description": "Who or what stands in their way. Empty keeps the current nemesis.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Drive",
          "type": "object"
        },
        "Enter": {
          "additionalProperties": false,
          "description": "Bring a cast member into the current scene.",
          "properties": {
            "verb": {
              "const": "enter",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of a cast member not already here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Enter",
          "type": "object"
        },
        "JoinParty": {
          "additionalProperties": false,
          "description": "A character here starts travelling with the player.",
          "properties": {
            "verb": {
              "const": "join_party",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of who is joining.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "JoinParty",
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Record that someone here has died.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of who here died.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Kill",
          "type": "object"
        },
        "Leave": {
          "additionalProperties": false,
          "description": "Take a cast member out of the current scene.",
          "properties": {
            "verb": {
              "const": "leave",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of someone here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Leave",
          "type": "object"
        },
        "LeaveParty": {
          "additionalProperties": false,
          "description": "A companion stops travelling with the player.",
          "properties": {
            "verb": {
              "const": "leave_party",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the companion leaving.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "LeaveParty",
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "Make a hidden entity known when the player notices, finds, or reaches it.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of an entity listed as hidden here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Reveal",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The one world change to apply; `verb` picks the change.",
          "discriminator": {
            "mapping": {
              "change_tags": "#/$defs/ChangeTags",
              "drive": "#/$defs/Drive",
              "enter": "#/$defs/Enter",
              "join_party": "#/$defs/JoinParty",
              "kill": "#/$defs/Kill",
              "leave": "#/$defs/Leave",
              "leave_party": "#/$defs/LeaveParty",
              "reveal": "#/$defs/Reveal"
            },
            "propertyName": "verb"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/Enter"
            },
            {
              "$ref": "#/$defs/Leave"
            },
            {
              "$ref": "#/$defs/ChangeTags"
            },
            {
              "$ref": "#/$defs/Drive"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/JoinParty"
            },
            {
              "$ref": "#/$defs/LeaveParty"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "next_scene",
    "description": "Say this scene's question is settled. The player is then asked what they want to pursue, and their own words build the next scene. Do not answer for them.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "job_done": {
          "default": false,
          "description": "A campaign only: settling this scene also finishes the job the player walked out on.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "roll_question",
    "description": "Roll Chance against Risk for one closed dramatic question.",
    "parameters": {
      "$defs": {
        "Position": {
          "enum": [
            "advantage",
            "neutral",
            "disadvantage"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or actor here who takes the action.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "question": {
          "description": "Closed question where yes means the actor gets what they want.",
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position",
          "default": "neutral",
          "description": "Which side the relevant tags and situation favour."
        },
        "edge": {
          "default": "",
          "description": "Tag or circumstance that sets the position. Empty for neutral.",
          "type": "string"
        },
        "opponent_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of the character here that resists. Null when nothing fights back."
        }
      },
      "required": [
        "actor_id",
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "restore_luck",
    "description": "Restore an actor's luck after a conflict ends.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or a character here.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  }
]
