{
  "additionalProperties": false,
  "properties": {
    "place": {
      "description": "Slug naming the place. Reuse it when the player returns here.",
      "type": "string"
    },
    "title": {
      "description": "The scene's title, read by the player. Name nothing hidden.",
      "type": "string"
    },
    "focus": {
      "default": "",
      "description": "What this scene is about, in one line the player reads. Name nothing hidden. Empty when the situation says it all.",
      "type": "string"
    },
    "situation": {
      "description": "What the player sees and knows on arrival. Hold nothing hidden here.",
      "type": "string"
    },
    "present": {
      "default": [],
      "description": "Ids of who and what is in the scene now.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "hidden": {
      "default": [],
      "description": "Ids of what is hidden here.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cast": {
      "description": "New people and things, each filed under its own id. A brief and a sheet are read once the player meets that entry, so neither names what is still hidden.",
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "additionalProperties": false,
          "description": "A character: a person, an object, a vehicle or a curse alike.",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "brief": {
              "type": "string"
            },
            "known": {
              "default": false,
              "type": "boolean"
            },
            "alive": {
              "default": true,
              "type": "boolean"
            },
            "chattiness": {
              "default": "normal",
              "description": "How readily they speak unprompted when travelling with the player. Most are normal.",
              "enum": [
                "quiet",
                "normal",
                "chatty"
              ],
              "type": "string"
            },
            "concept": {
              "default": "",
              "type": "string"
            },
            "tags": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "propertyNames": {
                "enum": [
                  "skill",
                  "frailty",
                  "gear",
                  "condition"
                ],
                "type": "string"
              },
              "type": "object"
            },
            "goal": {
              "default": "",
              "type": "string"
            },
            "motive": {
              "default": "",
              "type": "string"
            },
            "nemesis": {
              "default": "",
              "type": "string"
            },
            "luck": {
              "additionalProperties": false,
              "properties": {
                "current": {
                  "type": "integer"
                },
                "maximum": {
                  "type": "integer"
                }
              },
              "required": [
                "current",
                "maximum"
              ],
              "type": "object"
            },
            "defeated": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "brief"
          ],
          "type": "object"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "arc": {
      "default": "",
      "description": "The setup beyond this scene: pressures, motives, secrets, what can come. The player never reads it, so what ties one hidden thing to another belongs here.",
      "type": "string"
    },
    "recap": {
      "description": "One paragraph on the scene the player leaves: what they did, cost, learned and missed.",
      "type": "string"
    }
  },
  "required": [
    "place",
    "title",
    "situation",
    "recap"
  ],
  "type": "object"
}
