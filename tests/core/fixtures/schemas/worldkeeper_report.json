{
  "$defs": {
    "AdvanceThread": {
      "additionalProperties": false,
      "description": "Move a storyline the scenario is tracking: where it stands now, or that it is over.",
      "properties": {
        "op": {
          "const": "advance-thread",
          "default": "advance-thread",
          "title": "Op",
          "type": "string"
        },
        "thread_id": {
          "description": "Exact id of one thread in ACTIVE THREADS.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Thread Id",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "resolved",
                "dormant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the thread now stands, or null to leave it as it is.",
          "title": "Status"
        },
        "stage": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable slug for the point it has reached, or null to leave it as it is.",
          "title": "Stage"
        },
        "tick": {
          "default": 0,
          "description": "How many segments this fills on the thread's clock, when it has one.",
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "thread_id"
      ],
      "title": "AdvanceThread",
      "type": "object"
    },
    "Creation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "actor",
            "location",
            "item"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "The exact name used in the narration.",
          "title": "Name",
          "type": "string"
        },
        "brief": {
          "description": "One sentence describing it, consistent with the narration.",
          "title": "Brief",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/EntityDetail"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a person or item, the place they are: a location already in the catalogue, or one created this same turn. Null places them where the player is, and is also correct for a location entry itself.",
          "title": "Location"
        }
      },
      "required": [
        "kind",
        "name",
        "brief",
        "detail"
      ],
      "title": "Creation",
      "type": "object"
    },
    "EntityDetail": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "hook": {
          "title": "Hook",
          "type": "string"
        }
      },
      "required": [
        "description",
        "hook"
      ],
      "title": "EntityDetail",
      "type": "object"
    },
    "MemoryProposal": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact id of who this belongs to, or null for the world.",
          "title": "Owner Id"
        },
        "text": {
          "description": "One concrete sentence, past tense.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "text"
      ],
      "title": "MemoryProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "creations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Creation"
      },
      "title": "Creations",
      "type": "array"
    },
    "memories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryProposal"
      },
      "title": "Memories",
      "type": "array"
    },
    "thread_moves": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AdvanceThread"
      },
      "title": "Thread Moves",
      "type": "array"
    }
  },
  "title": "WorldkeeperReport",
  "type": "object"
}
