        "kind": {
          "enum": [
            "actor",
            "location",
            "item"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "The exact name used in the narration.",
          "title": "Name",
          "type": "string"
        },
        "brief": {
          "description": "One sentence describing it, consistent with the narration.",
          "title": "Brief",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/EntityDetail"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a person or item, the place they are: a location already in the catalogue, or one created this same turn. Null places them where the player is, and is also correct for a location entry itself.",
          "title": "Location"
        }
      },
      "required": [
        "kind",
        "name",
        "brief",
        "detail"
      ],
      "title": "Creation",
      "type": "object"
    },
    "EntityDetail": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "hook": {
          "title": "Hook",
          "type": "string"
        }
      },
      "required": [
        "description",
        "hook"
      ],
      "title": "EntityDetail",
      "type": "object"
    },
    "MemoryProposal": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact id of who this belongs to, or null for the world.",
          "title": "Owner Id"
        },
        "text": {
          "description": "One concrete sentence, past tense.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "text"
      ],
      "title": "MemoryProposal",
      "type": "object"
    }
