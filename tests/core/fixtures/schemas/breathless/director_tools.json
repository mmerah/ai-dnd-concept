          "description": "The helper's skill, or empty when they use an item."
        },
        "helper_item_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of the item the helper rolls instead, or null."
        },
        "helper_stunt": {
          "default": false,
          "description": "True when the helper stunts instead.",
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "goal",
        "risk",
        "dangerous"
      ],
      "type": "object"
    }
  },
  {
    "name": "test_luck",
    "description": "Let a die decide whether something happens.",
    "parameters": {
      "$defs": {
        "Die": {
          "enum": [
            4,
            6,
            8,
            10,
            12
          ],
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "properties": {
        "subject": {
          "description": "What may happen, in one line.",
          "minLength": 1,
          "type": "string"
        },
        "die": {
          "$ref": "#/$defs/Die",
          "description": "Die rated by the odds: d4 unlikely, d12 near certain."
        }
      },
      "required": [
        "subject",
        "die"
      ],
      "type": "object"
    }
  },
  {
    "name": "loot_check",
    "description": "Roll the actor's loot die to scavenge, when the fiction allows it.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or actor here who scavenges.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "seeking": {
          "description": "The item they hope to find, named like `a crowbar`.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "seeking"
      ],
      "type": "object"
    }
  },
  {
    "name": "change_stress",
    "description": "Add stress for a complication, or clear it for a secure rest.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or an actor here.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "amount": {
          "description": "Positive adds stress; negative clears it.",
          "type": "integer"
        },
        "why": {
          "description": "The complication or the rest, in one line.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "amount",
        "why"
      ],
      "type": "object"
    }
  },
  {
    "name": "use_med_kit",
    "description": "Spend the actor's med kit to clear 2 stress, when they say they use it.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or a party member here.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "actor_id"
      ],
      "type": "object"
    }
  }
]
