[
  {
    "name": "change_world",
    "description": "Apply one settled world change to match the story. Set `verb` to pick the change and fill that verb's own fields. One call makes one change.",
    "parameters": {
      "$defs": {
        "AddTrait": {
          "additionalProperties": false,
          "description": "Add a lasting condition or quality to an entity.",
          "properties": {
            "verb": {
              "const": "add_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id. An actor must be here with the player.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "name": {
              "description": "The trait's display name, such as `Battle Worn`; its id is derived.",
              "minLength": 1,
              "type": "string"
            },
            "text": {
              "description": "The trait's effect in plain language.",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "name",
            "text"
          ],
          "title": "AddTrait",
          "type": "object"
        },
        "AdvanceThreadArm": {
          "additionalProperties": false,
          "description": "Update an active storyline's status or note.",
          "properties": {
            "thread_id": {
              "description": "Exact id of an ACTIVE THREAD.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "active",
                    "resolved",
                    "dormant"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "New status, or null to keep the current status."
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "New private note for the Director, or null to keep the current note."
            },
            "verb": {
              "const": "advance_thread",
              "type": "string"
            }
          },
          "required": [
            "thread_id",
            "verb"
          ],
          "title": "AdvanceThreadArm",
          "type": "object"
        },
        "JoinParty": {
          "additionalProperties": false,
          "description": "Add an actor here to the player's party.",
          "properties": {
            "verb": {
              "const": "join_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor joining.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "JoinParty",
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Record that an actor has died. Their body and what they carried stay in the world.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor who has died. They must be here with the player.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "Kill",
          "type": "object"
        },
        "LeaveParty": {
          "additionalProperties": false,
          "description": "Remove an actor from the player's party.",
          "properties": {
            "verb": {
              "const": "leave_party",
              "type": "string"
            },
            "actor_id": {
              "description": "Exact id of the actor leaving.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "actor_id"
          ],
          "title": "LeaveParty",
          "type": "object"
        },
        "Move": {
          "additionalProperties": false,
          "description": "Move an actor to a new location, or move a nearby item.",
          "properties": {
            "verb": {
              "const": "move",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact actor or item id. The item must be carried by the player or loose here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "to_id": {
              "description": "Exact destination id. An actor moves to a location id. An item is taken by moving it to `player`, handed over by moving it to an actor here, and dropped by moving it to the id of the player's current location.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "to_id"
          ],
          "title": "Move",
          "type": "object"
        },
        "RemoveTrait": {
          "additionalProperties": false,
          "description": "Remove a lasting condition or quality that has ended.",
          "properties": {
            "verb": {
              "const": "remove_trait",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact entity id. An actor must be here with the player.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "trait_id": {
              "description": "Exact id of one of the entity's traits.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id",
            "trait_id"
          ],
          "title": "RemoveTrait",
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "Make a hidden entity known when the player notices, finds, or reaches it.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of the hidden entity.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Reveal",
          "type": "object"
        },
        "UnlockExit": {
          "additionalProperties": false,
          "description": "Unlock an exit from the player's location.",
          "properties": {
            "verb": {
              "const": "unlock_exit",
              "type": "string"
            },
            "to_id": {
              "description": "Exact id of the exit's destination.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "to_id"
          ],
          "title": "UnlockExit",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The one world change to apply; `verb` picks the change.",
          "discriminator": {
            "mapping": {
              "add_trait": "#/$defs/AddTrait",
              "advance_thread": "#/$defs/AdvanceThreadArm",
              "join_party": "#/$defs/JoinParty",
              "kill": "#/$defs/Kill",
              "leave_party": "#/$defs/LeaveParty",
              "move": "#/$defs/Move",
              "remove_trait": "#/$defs/RemoveTrait",
              "reveal": "#/$defs/Reveal",
              "unlock_exit": "#/$defs/UnlockExit"
            },
            "propertyName": "verb"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/Move"
            },
            {
              "$ref": "#/$defs/AddTrait"
            },
            {
              "$ref": "#/$defs/RemoveTrait"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/UnlockExit"
            },
            {
              "$ref": "#/$defs/JoinParty"
            },
            {
              "$ref": "#/$defs/LeaveParty"
            },
            {
              "$ref": "#/$defs/AdvanceThreadArm"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "stake_check",
    "description": "Show the player one check's `risk` and let them accept or revise it before rolling.",
    "parameters": {
      "$defs": {
        "Skill": {
          "enum": [
            "Bash",
            "Dash",
            "Sneak",
            "Shoot",
            "Think",
            "Sway"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "description": "Exact id of the player or actor here who takes the action.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "goal": {
          "description": "The actor's goal, in one line.",
          "minLength": 1,
          "type": "string"
        },
        "risk": {
          "description": "One-line cost of a bad roll, told to the player first. No roll without one.",
          "minLength": 1,
          "type": "string"
        },
        "dangerous": {
          "description": "True when failing could harm the actor; a vulnerable actor may then die.",
          "type": "boolean"
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Skill"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "description": "The skill rolled, or empty when an item or a stunt is used."
        },
        "item_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of a carried item rolled in place of a skill, or null."
        },
        "stunt": {
          "default": false,
          "description": "True to roll a d12 stunt instead of a skill or item.",
          "type": "boolean"
        },
        "helper_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of an ally here who also rolls and shares the risk, or null."
        },
        "helper_skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Skill"
            },
            {
              "const": "",
              "type": "string"
            }
          ],
          "default": "",
          "description": "The helper's skill, or empty when they use an item."
        },
        "helper_item_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact id of the item the helper rolls instead, or null."
        },
        "helper_stunt": {
          "default": false,
          "description": "True when the helper stunts instead.",
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "goal",
        "risk",
        "dangerous"
      ],
      "type": "object"
    }
  },
  {
