{
  "additionalProperties": false,
  "properties": {
    "place": {
      "description": "Slug naming the place. Reuse it when the player returns here.",
      "type": "string"
    },
    "title": {
      "description": "The scene's title, read by the player. Name nothing hidden.",
      "type": "string"
    },
    "focus": {
      "default": "",
      "description": "What this scene is about, in one line the player reads. Name nothing hidden. Leave it empty when the situation says it all.",
      "type": "string"
    },
    "situation": {
      "description": "What the player sees and knows on arrival. Hold nothing hidden here.",
      "type": "string"
    },
    "present": {
      "default": [],
      "description": "Ids of who and what is in the scene now.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "hidden": {
      "default": [],
      "description": "Ids of what is hidden here.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cast": {
      "description": "New people and things, each filed under its own id. The player reads a brief and a sheet after they meet that entry. Name nothing still hidden in either one.",
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "brief": {
              "type": "string"
            },
            "known": {
              "default": false,
              "type": "boolean"
            },
            "alive": {
              "default": true,
              "type": "boolean"
            },
            "chattiness": {
              "default": "normal",
              "description": "How readily they speak unprompted when travelling with the player. Most are normal.",
              "enum": [
                "quiet",
                "normal",
                "chatty"
              ],
              "type": "string"
            },
            "sheet": {
              "additionalProperties": false,
              "properties": {
                "items": {
                  "patternProperties": {
                    "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "bulky": {
                          "default": false,
                          "type": "boolean"
                        },
                        "breaks": {
                          "default": 1,
                          "minimum": 1,
                          "type": "integer"
                        },
                        "broken_times": {
                          "default": 0,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "upgraded": {
                          "default": false,
                          "type": "boolean"
                        },
                        "harmless": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "type": "object"
                    }
                  },
                  "propertyNames": {},
                  "type": "object"
                },
                "specialty": {
                  "type": "string"
                },
                "origin": {
                  "default": "",
                  "type": "string"
                },
                "traits": {
                  "default": [],
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "skills": {
                  "additionalProperties": {
                    "enum": [
                      8,
                      10,
                      12
                    ],
                    "type": "integer"
                  },
                  "type": "object"
                },
                "credits": {
                  "default": 2,
                  "minimum": 0,
                  "type": "integer"
                },
                "hindrances": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "specialty"
              ],
              "type": [
                "object",
                "null"
              ],
              "default": null,
              "description": "Leave empty."
            }
          },
          "required": [
            "id",
            "name",
            "brief"
          ],
          "type": "object"
        }
      },
      "propertyNames": {},
      "type": "object"
    },
    "arc": {
      "default": "",
      "description": "The setup beyond this scene: pressures, motives, secrets, and what can come. The player never reads it. Put here what ties one hidden thing to another.",
      "type": "string"
    },
    "recap": {
      "description": "One paragraph on the scene the player leaves: what the player did, paid, learned and missed.",
      "type": "string"
    }
  },
  "required": [
    "place",
    "title",
    "situation",
    "recap"
  ],
  "type": "object"
}
