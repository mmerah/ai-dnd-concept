  {
    "name": "next_scene",
    "description": "Call this with nothing set when the scene reaches a stopping point. Set `pursuit` instead once the player has left this place. Set `complication` instead to bring a new situation down on this place.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "pursuit": {
          "default": "",
          "description": "Where the player is going, in their own words. Empty to offer the way on.",
          "type": "string"
        },
        "complication": {
          "default": "",
          "description": "What arrives or turns here, and why. Empty otherwise.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "roll",
    "description": "Call this when the outcome of an action matters. The engine picks the dice, rolls them, and reads the result.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "what": {
          "description": "The attempt, in a few words the player reads.",
          "type": "string"
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of a hired party member here who acts. Null for the player."
        },
        "skill": {
          "default": "",
          "description": "Which skill to roll. Empty rolls the plain d6.",
          "type": "string"
        },
        "helped": {
          "default": "",
          "description": "Why circumstances help. Empty when none do.",
          "type": "string"
        },
        "helped_by": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Exact id of a hired member who rolls their own die. Null when none helps."
        },
        "hindered": {
          "default": "",
          "description": "Why the actor is hindered. Empty when none is.",
          "type": "string"
        },
        "risking_death": {
          "default": false,
          "description": "True when the actor risks death on this roll.",
          "type": "boolean"
        }
      },
      "required": [
        "what"
      ],
      "type": "object"
    }
  },
  {
    "name": "test_luck",
    "description": "Call this to ask about the world's bad luck when nobody acts. The engine rolls one d6 and reads it.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "A closed question about the world where nobody is acting.",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "job",
    "description": "Call this to look for work with `find`, to record agreed work with `take`, and to close the job with `finish`. The engine rolls, raises one skill for each operator, and pays each of them d6 credits.",
    "parameters": {
      "$defs": {
        "Raise": {
          "additionalProperties": false,
          "properties": {
            "actor_id": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "description": "Exact id of a hired party member here who acts. Null for the player."
            },
            "skill": {
              "description": "The skill the job called on for them.",
              "type": "string"
            }
          },
          "required": [
            "skill"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "verb": {
          "description": "`find` looks for work. `take` records agreed work. `finish` closes the job.",
          "enum": [
            "find",
            "take",
            "finish"
          ],
          "type": "string"
        },
        "where": {
          "default": "",
          "description": "Where the player looks for work, in a few words. With `find`.",
          "type": "string"
        },
        "terms": {
          "default": "",
          "description": "Who wants what done, what that looks like, and what it pays. With `take`.",
          "type": "string"
        },
        "raises": {
          "default": [],
          "description": "One per operator: the player and every living hired member. With `finish`.",
          "items": {
            "$ref": "#/$defs/Raise"
          },
          "type": "array"
        }
      },
      "required": [
        "verb"
      ],
      "type": "object"
    }
  },
  {
    "name": "hire",
    "description": "Call this when the player hires someone here to work. Someone already travelling with the player can be hired too. The worldsmith writes their sheet once the turn ends. Nothing more lands this turn.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "description": "Exact id of who here signs on.",
          "type": "string"
        },
        "terms": {
          "description": "What they are hired for, and on what terms, as agreed.",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "terms"
      ],
      "type": "object"
    }
