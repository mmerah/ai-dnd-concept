[
  {
    "name": "change_world",
    "description": "Apply one settled world change to match the story. Set `verb` to pick the change and fill that verb's own fields. One call makes one change.",
    "parameters": {
      "$defs": {
        "ChangeHindrances": {
          "additionalProperties": false,
          "description": "Record hindrances the player picks up, sheds, or both at once.",
          "properties": {
            "verb": {
              "const": "change_hindrances",
              "type": "string"
            },
            "gained": {
              "default": [],
              "description": "Hindrances the player now carries, that they did not before.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "lost": {
              "default": [],
              "description": "Hindrances the player no longer carries.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "verb"
          ],
          "title": "ChangeHindrances",
          "type": "object"
        },
        "DropItem": {
          "additionalProperties": false,
          "description": "Take an item out of the player's kit for good.",
          "properties": {
            "verb": {
              "const": "drop_item",
              "type": "string"
            },
            "item_id": {
              "description": "Exact id of an item the player carries.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "item_id"
          ],
          "title": "DropItem",
          "type": "object"
        },
        "Enter": {
          "additionalProperties": false,
          "description": "Bring a cast member into the current scene.",
          "properties": {
            "verb": {
              "const": "enter",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of a cast member not already here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Enter",
          "type": "object"
        },
        "GainItem": {
          "additionalProperties": false,
          "description": "Add an item to the player's kit, spending credits when it costs any.",
          "properties": {
            "verb": {
              "const": "gain_item",
              "type": "string"
            },
            "name": {
              "description": "The item's name.",
              "minLength": 1,
              "type": "string"
            },
            "bulky": {
              "default": false,
              "description": "True when the item takes real space to carry.",
              "type": "boolean"
            },
            "breaks": {
              "default": 1,
              "description": "How many times the item can break before it is ruined.",
              "minimum": 1,
              "type": "integer"
            },
            "cost": {
              "default": 0,
              "description": "Credits spent for the item; `cost` 0 only for a thing found or given.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "verb",
            "name"
          ],
          "title": "GainItem",
          "type": "object"
        },
        "Kill": {
          "additionalProperties": false,
          "description": "Record that someone here has died.",
          "properties": {
            "verb": {
              "const": "kill",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of who here died.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Kill",
          "type": "object"
        },
        "Leave": {
          "additionalProperties": false,
          "description": "Take a cast member out of the current scene.",
          "properties": {
            "verb": {
              "const": "leave",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of someone here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Leave",
          "type": "object"
        },
        "RepairItem": {
          "additionalProperties": false,
          "description": "Fix a broken item, spending credits when the repair costs any.",
          "properties": {
            "verb": {
              "const": "repair_item",
              "type": "string"
            },
            "item_id": {
              "description": "Exact id of an item the player carries.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            "cost": {
              "default": 0,
              "description": "Credits spent on the repair.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "verb",
            "item_id"
          ],
          "title": "RepairItem",
          "type": "object"
        },
        "Reveal": {
          "additionalProperties": false,
          "description": "Make a hidden entity known when the player notices, finds, or reaches it.",
          "properties": {
            "verb": {
              "const": "reveal",
              "type": "string"
            },
            "entity_id": {
              "description": "Exact id of an entity listed as hidden here.",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "verb",
            "entity_id"
          ],
          "title": "Reveal",
          "type": "object"
        },
        "Spend": {
          "additionalProperties": false,
          "description": "Pay credits for anything that is not an item or a repair: bribes, care, passage.",
          "properties": {
            "verb": {
              "const": "spend",
              "type": "string"
            },
            "amount": {
              "description": "Credits spent.",
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            "why": {
              "description": "What the credits pay for, in a few words.",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "verb",
            "amount",
            "why"
          ],
          "title": "Spend",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "The one world change to apply; `verb` picks the change.",
          "discriminator": {
            "mapping": {
              "change_hindrances": "#/$defs/ChangeHindrances",
              "drop_item": "#/$defs/DropItem",
              "enter": "#/$defs/Enter",
              "gain_item": "#/$defs/GainItem",
              "kill": "#/$defs/Kill",
              "leave": "#/$defs/Leave",
              "repair_item": "#/$defs/RepairItem",
              "reveal": "#/$defs/Reveal",
              "spend": "#/$defs/Spend"
            },
            "propertyName": "verb"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Reveal"
            },
            {
              "$ref": "#/$defs/Enter"
            },
            {
              "$ref": "#/$defs/Leave"
            },
            {
              "$ref": "#/$defs/Kill"
            },
            {
              "$ref": "#/$defs/ChangeHindrances"
            },
            {
              "$ref": "#/$defs/GainItem"
            },
            {
              "$ref": "#/$defs/DropItem"
            },
            {
              "$ref": "#/$defs/RepairItem"
            },
            {
              "$ref": "#/$defs/Spend"
            }
          ]
        }
      },
      "required": [
        "change"
      ],
      "type": "object"
    }
  },
  {
    "name": "next_scene",
    "description": "Say this scene's question is settled. The player is then asked what they want to pursue, and their own words build the next scene. Do not answer for them.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "pursuit": {
          "default": "",
          "description": "Set when the player has left this place for good with its question open: where they are going, in their own words. Empty when the question settled here.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "attempt",
    "description": "Roll for something whose outcome matters. Name `helped` with why circumstances help — an ally who pitches in counts, named in it: the SRD gives them their own die, but here it is the d6 of circumstance, because an NPC carries no dice. Name `hindered` with why the player is hindered, when they are.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "what": {
          "description": "The action, in a few words; it heads the card.",
          "minLength": 1,
          "type": "string"
        },
        "skill": {
          "default": "",
          "description": "Which skill to roll; empty rolls the plain d6.",
          "type": "string"
        },
        "helped": {
          "default": "",
          "description": "Why circumstances help, when they do.",
          "type": "string"
        },
        "hindered": {
          "default": "",
          "description": "Why the player is hindered, when they are.",
          "type": "string"
        },
        "risking_death": {
          "default": false,
          "description": "True when a disaster kills the player and a setback maims them; say it before the roll.",
          "type": "boolean"
        }
      },
      "required": [
        "what"
      ],
      "type": "object"
    }
  },
  {
    "name": "test_luck",
    "description": "Roll a d6 to test the world's bad luck, where nobody is acting.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "A closed question about the world where nobody is acting.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    }
  },
  {
    "name": "defend",
    "description": "Break a carried item to turn a hit into a hindrance instead of taking it outright; word the harm yourself.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "description": "Exact id of the item the player breaks to defend.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "hindrance": {
          "description": "What the harm the player takes becomes, as a hindrance.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "hindrance"
      ],
      "type": "object"
    }
  },
  {
    "name": "after_job",
    "description": "The SRD's after-a-job step, once per job, when the player's own words close it: raise the named skill and pay out its credits.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "skill": {
          "description": "The skill the job called on, named by the player, to raise.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "skill"
      ],
      "type": "object"
    }
  }
]
